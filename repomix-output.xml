<file path="parse_dom.js">
const fs = require('fs');
const html = fs.readFileSync('index.html', 'utf8');

let depth = 0;
let inApp = false;
let appDepth = -1;
const lines = html.split('\n');

for (let i = 0; i < lines.length; i++) {
  const line = lines[i];
  
  const openMatches = line.match(/<div|<header|<aside|<footer|<section|<nav/g);
  const closeMatches = line.match(/<\/div>|<\/header>|<\/aside>|<\/footer>|<\/section>|<\/nav>/g);
  
  if (line.includes('class="app"')) {
    inApp = true;
    appDepth = depth;
    console.log(`Found .app at line ${i+1}, depth ${depth}`);
  }
  
  if (openMatches) depth += openMatches.length;
  
  if (inApp && depth === appDepth + 1) {
    if (openMatches) {
       console.log(`Direct child of .app found at line ${i+1}: ${line.trim()}`);
    }
  }
  
  if (closeMatches) depth -= closeMatches.length;
  
  if (inApp && depth <= appDepth) {
    console.log(`Closed .app at line ${i+1}`);
    inApp = false;
  }
}
</file>

