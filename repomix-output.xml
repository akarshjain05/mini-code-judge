<!-- ── Onboarding Modal (shown after register / Google signup) ─────── -->
<div class="modal-backdrop" id="onboardingModal" style="display:none;align-items:center;justify-content:center">
  <div class="modal" style="width:100%;max-width:420px;text-align:center">

    <!-- Step indicator -->
    <div style="display:flex;justify-content:center;gap:6px;margin-bottom:24px">
      <div id="ob-dot-1" style="width:8px;height:8px;border-radius:50%;background:var(--accent);transition:background 0.2s"></div>
      <div id="ob-dot-2" style="width:8px;height:8px;border-radius:50%;background:var(--border);transition:background 0.2s"></div>
    </div>

    <!-- Avatar -->
    <div id="obAvatar" style="width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#bc8cff);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:700;color:#fff;margin:0 auto 14px">?</div>

    <!-- Step 1: Full Name -->
    <div id="ob-step-1">
      <div style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:6px">What's your name?</div>
      <div style="font-size:13px;color:var(--muted);margin-bottom:22px">This is your display name — shown on your profile and leaderboard.</div>
      <div class="form-group" style="text-align:left">
        <label>Full Name</label>
        <input type="text" id="obFullName" placeholder="e.g. Alex Chen" maxlength="100" style="font-size:15px" />
      </div>
      <div class="alert" id="obStep1Alert" style="margin-top:8px"></div>
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:18px">
        <button class="btn btn-primary" style="width:100%;justify-content:center;padding:12px" onclick="obNextStep()">Continue →</button>
        <button class="btn btn-ghost" style="width:100%;justify-content:center;padding:10px;font-size:13px" onclick="obSkipStep()">Skip for now</button>
      </div>
    </div>

    <!-- Step 2: Date of Birth -->
    <div id="ob-step-2" style="display:none">
      <div style="font-size:18px;font-weight:700;color:var(--text);margin-bottom:6px">When were you born?</div>
      <div style="font-size:13px;color:var(--muted);margin-bottom:22px">Optional — only used for your profile, never shown publicly.</div>
      <div class="form-group" style="text-align:left">
        <label>Date of Birth</label>
        <input type="date" id="obDob" max="" style="color:var(--text);background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px 14px;font-size:14px;width:100%;outline:none" />
      </div>
      <div class="alert" id="obStep2Alert" style="margin-top:8px"></div>
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:18px">
        <button class="btn btn-primary" style="width:100%;justify-content:center;padding:12px" onclick="obFinish()">Finish Setup 🎉</button>
        <button class="btn btn-ghost" style="width:100%;justify-content:center;padding:10px;font-size:13px" onclick="obFinish(true)">Skip for now</button>
      </div>
    </div>

  </div>
</div>
</body>
</html>
