      </div>
      <div class="form-group">
        <label>Password</label>
        <div style="position:relative">
          <input type="password" id="loginPassword" placeholder="••••••••" style="padding-right:42px" />
          <button type="button" onclick="togglePasswordVisibility('loginPassword', this)" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--muted);padding:4px;display:flex" aria-label="Show password">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>
      <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:4px" onclick="doLogin()">
        Login
      </button>
      <div style="text-align:center;margin-top:12px">
        <a href="#" onclick="showForgotPassword()" style="font-size:12px;color:var(--accent);text-decoration:none">Forgot password?</a>
      </div>
    </div>

    <!-- Forgot Password form -->
    <div id="forgotPasswordForm" style="display:none">
      <div class="alert" id="forgotErr"></div>
      <p style="font-size:13px;color:var(--muted);margin-bottom:14px">Enter your email and we'll send you a password reset link.</p>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="forgotEmail" placeholder="you@example.com" />
      </div>
