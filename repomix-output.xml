        <a href="#" onclick="showForgotPassword(false)" style="font-size:12px;color:var(--muted);text-decoration:none">← Back to login</a>
      </div>
    </div>

    <!-- Register -->
    <div id="registerForm" style="display:none">
      <div class="alert alert-error" id="registerErr"></div>
      <div class="form-group">
        <label>Username</label>
        <input type="text" id="regUsername" placeholder="akarsh" />
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="regEmail" placeholder="you@example.com" />
      </div>
      <div class="form-group">
        <label>Password</label>
